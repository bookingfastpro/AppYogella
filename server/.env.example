# ─── Base de données Supabase ────────────────────────────────────────────────
#
# Dashboard Supabase → Connect → ORMs → Prisma. Les deux URLs passent par le
# pooler : l'hôte direct db.<ref>.supabase.co est en IPv6 uniquement.
#
# DATABASE_URL : runtime, pooler de transactions (6543). ?pgbouncer=true est
#                obligatoire.
# DIRECT_URL   : `prisma migrate deploy`, pooler de sessions (5432).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# ─── Supabase Auth ──────────────────────────────────────────────────────────
# Project Settings → API Keys. Utilisées par le serveur uniquement.
# La clé secrète sert à créer les comptes et à changer leur e-mail depuis
# l'admin : ne jamais l'exposer côté navigateur.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
# Facultatif : déduit de SUPABASE_URL par défaut.
# SUPABASE_JWKS_URL="https://<ref>.supabase.co/auth/v1/.well-known/jwks.json"

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000
HOST="0.0.0.0"

# Origines autorisées par CORS (séparées par des virgules). La première sert
# aussi d'URL de retour après le paiement Stripe.
# En production le SPA est servi par le même process : mettre le domaine public.
WEB_ORIGIN="http://localhost:4000"

# Répertoire des vidéos uploadées depuis l'admin.
# En conteneur : monter un volume persistant sur ce chemin.
UPLOAD_DIR="./uploads"

# Répertoire du build du front servi par l'API (vide = API seule, mode dev).
# Défini automatiquement dans l'image Docker.
# WEB_DIST_DIR="/app/web"

# ─── Stripe (facultatif) ────────────────────────────────────────────────────
# Sans clé, les endpoints de paiement renvoient un 503 explicite.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
